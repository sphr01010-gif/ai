# Never commit actual credentials. Add real values only to Railway Variables or a local .env.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Optional AI providers; at least one provider key is required.
APMIX_API_KEY=
APMIX_MODEL=claude-sonnet-4-6-free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
RIVER_API_KEY=
RIVER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
RADOX_API_KEY=
RADOX_MODEL=deepseek-v4-flash-0731
RADOX_VISION_MODEL=gpt-5.6-luna
AI_PROVIDER_ORDER=apmix,gemini,groq,river,radox

TAVILY_API_KEY=

# Optional image generation providers; choose from the Telegram menu.
# Cloudflare Workers AI FLUX.1 [schnell]
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Pollinations (Pollen balance/usage limits apply; not unlimited free usage)
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
# Pollinations text-to-speech (uses the same API key and Pollen balance)
POLLINATIONS_TTS_MODEL=google/gemini-3.8-flash-tts
POLLINATIONS_TTS_VOICE=Kore
TIMEZONE=Asia/Tehran
BOT_DATA_DIR=./data
LOG_LEVEL=INFO
