# Never commit actual credentials. Add real values only to Railway Variables or a local .env.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Optional AI providers; at least one provider key is required.
APMIX_API_KEY=
APMIX_MODEL=claude-sonnet-4-6-free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=orcarouter/auto
AI_PROVIDER_ORDER=apmix,gemini,orcarouter

TAVILY_API_KEY=

# Optional image generation: Cloudflare Workers AI FLUX.1 [schnell]
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
TIMEZONE=Asia/Tehran
BOT_DATA_DIR=./data
LOG_LEVEL=INFO
